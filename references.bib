Read\_Status\_Date: 2025-06-25T15:55:11.505Z},
  file = {/Users/daniel/Zotero/storage/QMUVLITK/Shafran et al. - 2023 - Coming of age A reflection of the first 21 years of cognitive behaviour therapy for perfectionism.pdf}
