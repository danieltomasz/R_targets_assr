  file = {/Users/daniel/Zotero/storage/6GT85KEX/Diehl and Redish - 2024 - Measuring excitation-inhibition balance through spectral components of local field potentials.pdf}
}

@article{dimmock2023BayesianAnalysisPhase,
  title = {Bayesian Analysis of Phase Data in {{EEG}} and {{MEG}}},
  author = {Dimmock, Sydney and O'Donnell, Cian and Houghton, Conor J},
