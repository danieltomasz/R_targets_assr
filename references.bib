@article{vanbree2023CriticalPerspectiveNeural,
  title = {A {{Critical Perspective}} on {{Neural Mechanisms}} in {{Cognitive Neuroscience}}: {{Towards Unification}}},
  shorttitle = {A {{Critical Perspective}} on {{Neural Mechanisms}} in {{Cognitive Neuroscience}}},
  author = {{van Bree}, Sander},
