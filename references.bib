@article{fernandez-ruiz2023FrequencyGammaOscillations,
  title = {Over and above Frequency: {{Gamma}} Oscillations as Units of Neural Circuit Operations},
  shorttitle = {Over and above Frequency},
  author = {{Fernandez-Ruiz}, Antonio and Sirota, Anton and {Lopes-dos-Santos}, V{\'i}tor and Dupret, David},
  year = 2023,
  month = apr,
  journal = {Neuron},
  volume = {111},
  number = {7},
  pages = {936--953},
  publisher = {Elsevier},
  issn = {0896-6273},
  doi = {10.1016/j.neuron.2023.02.026},
  urldate = {2023-04-05},
  abstract = {Gamma oscillations ({$\sim$}30--150~Hz) are widespread correlates of neural circuit functions. These network activity patterns have been described across multiple animal species, brain structures, and behaviors, and are usually identified based on their spectral peak frequency. Yet, despite intensive investigation, whether gamma oscillations implement causal mechanisms of specific brain functions or represent a general dynamic mode of neural circuit operation remains unclear. In this perspective, we review recent advances in the study of gamma oscillations toward a deeper understanding of their cellular mechanisms, neural pathways, and functional roles. We discuss that a given gamma rhythm does not per se implement any specific cognitive function but rather constitutes an activity motif reporting the cellular substrates, communication channels, and computational operations underlying information processing in its generating brain circuit. Accordingly, we propose shifting the attention from a frequency-based to a circuit-level definition of gamma oscillations.},
  langid = {english},
  keywords = {notion,ObsCite},
  file = {/Users/daniel/Zotero/storage/PEXHVG8J/Fernandez-Ruiz et al. - 2023 - Over and above frequency Gamma oscillations as units of neural circuit operations.pdf}
}

@article{fitzsimmons2024TMSinducedPlasticityImproving,
  title = {{{TMS-induced}} Plasticity Improving Cognitive Control in {{OCD I}}: {{Clinical}} and Neuroimaging Outcomes from a Randomised Trial},
  shorttitle = {{{TMS-induced}} Plasticity Improving Cognitive Control in {{OCD I}}},
  author = {Fitzsimmons, Sophie M. D. D. and Postma, Tjardo and {van Campen}, A. Dilene and Vriend, Chris and Batelaan, Neeltje M. and {van Oppen}, Patricia and Hoogendoorn, Adriaan W. and {van der Werf}, Ysbrand D. and {van den Heuvel}, Odile A.},
  year = 2024,
  month = jul,
  journal = {Biological Psychiatry},
  issn = {0006-3223},
  doi = {10.1016/j.biopsych.2024.06.029},
  urldate = {2024-09-21},
  abstract = {Background Repetitive transcranial magnetic stimulation (rTMS) is an emerging treatment for obsessive-compulsive disorder (OCD). The neurobiological mechanisms of rTMS in OCD have been incompletely characterized. We compared clinical outcomes and changes in task-based brain activation following three different rTMS stimulation protocols, all combined with exposure and response prevention (ERP). Methods In this three-arm proof-of-concept randomized trial, 61 treatment-refractory adult OCD patients received 16 sessions of rTMS immediately prior to ERP over 8 weeks, with task-based functional MRI (tb-fMRI) scans and clinical assessments pre- and post-treatment. Patients received either: high frequency (HF) rTMS to the left dorsolateral prefrontal cortex (DLPFC)(n=19(6M/13F)); HF rTMS to the left pre-supplementary motor area (preSMA)(n=23(10M/13F)); or control rTMS to the vertex(n=19(6M/13F)). Changes in tb-fMRI activation pre-post treatment were compared using both a Bayesian region-of-interest and a general linear model whole-brain approach. Results Mean OCD symptom severity decreased significantly in all treatment groups (delta=-10.836, p{$<$}0.001, 95\% CI[-12.504,-9.168]), with no differences between groups. Response rate in the entire sample was 57.4\%. The DLPFC rTMS group showed decreased planning-related activation post-treatment that was associated with greater symptom improvement. No group-level activation changes were observed for the preSMA or vertex rTMS groups. Participants with greater symptom improvement in the preSMA group showed decreased error-related activation, and symptom improvement in the vertex group was associated with increased inhibition-related activation. Conclusions PreSMA and DLPFC rTMS combined with ERP led to activation decreases in targeted task networks in individuals showing greater symptom improvement, although we observed no differences in symptom reduction between groups.},
  keywords = {cognitive control,exposure and response prevention psychotherapy,functional MRI,notion,OCD,rTMS,task-based fMRI},
  file = {/Users/daniel/Zotero/storage/QGUJ3IW6/Fitzsimmons et al. - 2024 - TMS-induced plasticity improving cognitive control in OCD I Clinical and neuroimaging outcomes from.pdf}
}

