@article{hardstone2012DetrendedFluctuationAnalysis,
  title = {Detrended {{Fluctuation Analysis}}: {{A Scale-Free View}} on {{Neuronal Oscillations}}},
  shorttitle = {Detrended {{Fluctuation Analysis}}},
  author = {Hardstone, Richard and Poil, Simon-Shlomo and Schiavone, Giuseppina and Jansen, Rick and Nikulin, Vadim V. and Mansvelder, Huibert D. and {Linkenkaer-Hansen}, Klaus},
