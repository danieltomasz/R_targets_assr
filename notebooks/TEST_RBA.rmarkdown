```{r}
library(dplyr)
library(ggplot2)
library(ggdist)  
library(tidyr)
library(patchwork)

itpc <- readr::read_csv(here::here("data/Destrieux_final_itpc.csv")) |>
  dplyr::filter(type %in% c("prestim_itpc", "stim_itpc")) |>
  dplyr::mutate(
    S = dplyr::case_when(
      type == "prestim_itpc" ~ "prestim",
      type == "stim_itpc" ~ "stim",
      TRUE ~ type
    ),
    itpc = value
  ) |>
  dplyr::select(subject, roi, P, T, S, itpc) |>
  dplyr::distinct() #|>
#  dplyr::filter(P == "pre")

head(itpc)



# (Optional but safe) collapse duplicates first
itpc_avg <- itpc %>%
  group_by(subject, roi, S) %>%
  summarise(itpc = mean(itpc, na.rm = TRUE), .groups = "drop")

# Wide format: one row per subject × roi × T
itpc_wide <- itpc_avg %>%
  mutate(S = factor(S, levels = c("prestim", "stim"))) %>%  # ensure column order
  pivot_wider(
    names_from  = S,
    values_from = itpc
  ) %>%
  # compute differences
  mutate(
    diff_itpc = stim - prestim,                      # absolute difference
  )

# If you want to drop rows missing either condition:
itpc_wide <- itpc_wide %>% tidyr::drop_na(prestim, stim)

itpc_wide %>% glimpse()

p_halfeye <- ggplot(itpc, aes(y = S, x = itpc, fill = S)) +
  stat_halfeye(point_interval = median_qi,
               .width = c(0.50, 0.80, 0.95),
               adjust = 0.7, slab_alpha = 0.6) +
  scale_x_continuous(limits = c(0, 1)) +
  labs(title = "Half-eye: distribution and quantile intervals", x = "ITPC", y = NULL) +
  theme(legend.position = "none")
p_halfeye 
```
```{r}
# packages
library(dplyr)
library(tidyr)
library(readr)
library(here)
library(ggplot2)
library(ggdist)
library(patchwork)

# --- load & tidy ---
itpc <- readr::read_csv(here::here("data/Destrieux_final_itpc.csv")) %>%
  dplyr::filter(type %in% c("prestim_itpc", "stim_itpc")) %>%
  mutate(
    S = case_when(
      type == "prestim_itpc" ~ "prestim",
      type == "stim_itpc"    ~ "stim",
      TRUE ~ type
    ),
    itpc = value
  ) %>%
  select(subject, roi, P, T, S, itpc) %>%
  distinct()

# (optional but safe) average duplicate rows first
itpc_avg <- itpc %>%
  group_by(subject, roi, S) %>%
  summarise(itpc = mean(itpc, na.rm = TRUE), .groups = "drop")

# wide format + within-subject difference
itpc_wide <- itpc_avg %>%
  mutate(S = factor(S, levels = c("prestim", "stim"))) %>%
  pivot_wider(names_from = S, values_from = itpc) %>%
  drop_na(prestim, stim) %>%
  mutate(diff_itpc = stim - prestim)

# --- plots ---
# 1) Half-eye for ITPC by condition (no title)
p_cond <- ggplot(itpc_avg, aes(x = itpc, y = S, fill = S)) +
  stat_halfeye(point_interval = median_qi,
               .width = c(0.50, 0.80, 0.95),
               adjust = 0.7, slab_alpha = 0.6) +
  scale_x_continuous(limits = c(0, 1)) +
  labs(x = "ITPC", y = NULL) +
  theme_minimal(base_size = 12) +
  theme(legend.position = "none",
        plot.title = element_blank())

# 2) Half-eye for paired differences (stim − prestim), with 0 line (no title)
p_diff <- ggplot(itpc_wide, aes(x = diff_itpc, y = "stim − prestim")) +
  stat_halfeye(point_interval = median_qi,
               .width = c(0.50, 0.80, 0.95),
               adjust = 0.7, slab_alpha = 0.6, fill = "grey60") +
  geom_vline(xintercept = 0, linetype = "dashed") +
  labs(x = "Δ ITPC (stim − prestim)", y = NULL) +
  theme_minimal(base_size = 12) +
  theme(plot.title = element_blank())

# combine vertically; no titles/captions
p_combined <- p_cond / p_diff +
  plot_layout(heights = c(2, 1))

p_combined
```
```{r}
library(scales)  # for nice breaks

# --- shared x from data ---
vals_cond <- itpc_avg$itpc
vals_diff <- itpc_wide$diff_itpc

rng          <- range(c(vals_cond, vals_diff), na.rm = TRUE)
pad          <- diff(rng) * 0.04
xlim_shared  <- c(rng[1] - pad, rng[2] + pad)
breaks_shared <- breaks_extended(n = 7)(c(vals_cond, vals_diff))

# ITPC by condition
p_cond <- ggplot(itpc_avg, aes(x = itpc, y = S, fill = S)) +
  stat_halfeye(point_interval = median_qi,
               .width = c(0.50, 0.80, 0.95),
               adjust = 0.7, slab_alpha = 0.6) +
  scale_x_continuous(limits = xlim_shared,
                     breaks = breaks_shared,
                     expand = expansion(mult = c(0, 0.02))) +
  labs(x = NULL, y = NULL) +
  theme_minimal(base_size = 12) +
  theme(legend.position = "none",
        plot.title = element_blank(),
        axis.text.x  = element_blank(),
        axis.ticks.x = element_blank())

# Paired differences (stim − prestim)
p_diff <- ggplot(itpc_wide, aes(x = diff_itpc, y = "stim − prestim")) +
  stat_halfeye(point_interval = median_qi,
               .width = c(0.50, 0.80, 0.95),
               adjust = 0.7, slab_alpha = 0.6, fill = "grey60") +
  geom_vline(xintercept = 0, linetype = "dashed") +
  scale_x_continuous(limits = xlim_shared,
                     breaks = breaks_shared,
                     expand = expansion(mult = c(0, 0.02))) +
  labs(x = "Shared x-axis (from data)", y = NULL) +
  theme_minimal(base_size = 12) +
  theme(plot.title = element_blank())

p_combined <- p_cond / p_diff + patchwork::plot_layout(heights = c(2, 1))
p_combined
```
